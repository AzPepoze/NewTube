{
	"name": "newtube",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun utils/dev.ts",
		"dev:chromium": "bun utils/dev.ts",
		"dev:firefox": "bun utils/dev.ts --firefox",
		"build": "bun utils/build.ts",
		"build:prod": "bun utils/build.ts --production",
		"release": "bun utils/build.ts --release",
		"check": "bun utils/check.ts",
		"format": "prettier --write .",
		"test:firefox": "web-ext run --pref gfx.webrender.all=true --source-dir=./out/dist/firefox",
		"test:chromium": "web-ext run --target=chromium --source-dir=./out/dist/chromium"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.40.0",
		"@uiw/codemirror-theme-dracula": "^4.25.8",
		"codemirror": "^6.0.2",
		"colorthief": "^3.3.1",
		"jszip": "^3.10.1",
		"material-icons": "^1.13.14",
		"prism-code-editor": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.1.42",
		"@types/node": "^25.6.2",
		"chokidar": "^5.0.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^10.3.0",
		"eslint-plugin-svelte": "^3.17.1",
		"fs-extra": "^11.3.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"sass": "^1.99.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"svelte-eslint-parser": "^1.6.1",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"web-ext": "^10.1.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"sharp",
		"spawn-sync"
	]
}
