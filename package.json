{
	"scripts": {
		"dev:firefox": "bun utils/dev.ts --firefox",
		"dev:chromium": "bun utils/dev.ts",
		"build": "bun run build:css && bun run build:types && bun run build:module && bun utils/builderExtension.ts --production --once",
		"release": "bun run build && bun utils/builderRelease.ts",
		"check": "bun utils/check.ts",
		"dev:js": "bun utils/builderExtension.ts",
		"dev:css": "sass --watch src/styleshift/styles/setting.scss out/build/style.css --style=compressed --no-source-map --load-path=node_modules",
		"build:css": "sass src/styleshift/styles/setting.scss out/build/style.css --style=compressed --no-source-map --load-path=node_modules",
		"build:module": "bun utils/builderModules.ts",
		"build:types": "tsc -p utils/tsconfigBuilderTypes.json && bun run build:template",
		"build:template": "bun utils/builderTemplate.ts -p utils/tsconfigBuilderTypes.json",
		"test:firefox": "web-ext run --pref gfx.webrender.all=true --source-dir=./out/dist/firefox",
		"test:chromium": "web-ext run --target=chromium --source-dir=./out/dist/chromium"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/state": "^6.6.0",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.40.0",
		"codemirror": "^6.0.2",
		"colorthief": "^2.7.0",
		"jszip": "^3.10.1",
		"material-icons": "^1.13.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.1.37",
		"@types/node": "^25.5.0",
		"archiver": "^7.0.1",
		"azpepoze.node_tools": "^1.0.4",
		"chokidar": "^5.0.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.3.1",
		"esbuild": "^0.27.4",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^10.0.3",
		"eslint-plugin-svelte": "^3.15.2",
		"fs-extra": "^11.3.4",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"sass": "^1.98.0",
		"svelte": "^5.53.11",
		"svelte-check": "^4.4.5",
		"svelte-eslint-parser": "^1.6.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"web-ext": "^9.4.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"esbuild",
		"sharp",
		"spawn-sync"
	]
}
