{
	"name": "newtube",
	"type": "module",
	"scripts": {
		"dev": "bun utils/dev.ts",
		"dev:chromium": "bun utils/dev.ts",
		"dev:firefox": "bun utils/dev.ts --firefox",
		"build": "bun utils/build.ts",
		"build:prod": "bun utils/build.ts --production",
		"release": "bun utils/build.ts --release",
		"check": "bun utils/check.ts",
		"format": "prettier --write .",
		"test:firefox": "web-ext run --pref gfx.webrender.all=true --source-dir=./out/dist/firefox",
		"test:chromium": "web-ext run --target=chromium --source-dir=./out/dist/chromium"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@uiw/codemirror-theme-dracula": "^4.25.12",
		"codemirror": "^6.0.2",
		"colorthief": "^3.5.0",
		"jszip": "^3.10.2",
		"material-icons": "^1.13.14"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.6",
		"@types/node": "^26.6.5",
		"chokidar": "^6.0.0",
		"concurrently": "^10.0.6",
		"dotenv": "^18.0.9",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fs-extra": "^11.4.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.106.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.10.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.0",
		"web-ext": "^10.8.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"sharp",
		"spawn-sync"
	],
	"packageManager": "bun@1.4.4"
}
