{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"types": ["chrome", "node"],
		"lib": ["es2022", "dom"],
		"downlevelIteration": true,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@main/*": ["src/main/*"],
			"@styleshift/*": ["src/styleshift/*"],
			"@core/*": ["src/styleshift/core/*"],
			"@ui/*": ["src/styleshift/ui/*"],
			"@settings/*": ["src/styleshift/settings/*"],
			"@functions/*": ["src/styleshift/build-in-functions/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.svelte.ts", "utils/**/*.ts", "eslint.config.mts"],
	"exclude": ["node_modules"]
}
