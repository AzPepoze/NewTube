{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"declaration": true,
		"emitDeclarationOnly": true,
		"allowJs": true,
		"skipLibCheck": true,
		"types": ["chrome", "node"],
		"outDir": "../out/template/types",
		"baseUrl": ".",
		"paths": {
			"@/*": ["../src/*"],
			"@core/*": ["../src/core/*"],
			"@ui/*": ["../src/ui/*"],
			"@settings/*": ["../src/settings/*"],
			"@extensions/*": ["../src/extensions/*"],
			"@shared/*": ["../src/shared/*"],
			"@functions/*": ["../src/core/shared/extensionHelpers.ts"]
		}
	},
	"include": ["../src/core/shared/extensionHelpers.ts", "../src/ambient.d.ts"],
	"exclude": ["../node_modules"]
}
