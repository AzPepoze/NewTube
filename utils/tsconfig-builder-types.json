{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"declaration": true,
		"emitDeclarationOnly": true,
		"allowJs": true,
		"skipLibCheck": true,
		"types": ["chrome", "node"],
		"outDir": "../out/template/types",
		"baseUrl": ".",
		"paths": {
			"@/*": ["../src/*"],
			"@main/*": ["../src/main/*"],
			"@styleshift/*": ["../src/styleshift/*"],
			"@core/*": ["../src/styleshift/core/*"],
			"@ui/*": ["../src/styleshift/ui/*"],
			"@settings/*": ["../src/styleshift/settings/*"],
			"@functions/*": ["../src/styleshift/build-in-functions/*"]
		}
	},
	"include": ["../src/styleshift/build-in-functions/extension.ts", "../src/ambient.d.ts"],
	"exclude": ["../node_modules"]
}
